{
  "name": "dsh-preset-scaffold",
  "version": "0.1.3",
  "description": "DSH (DeepSeek Harness) scaffold plugin & preset: strict 5-phase init runbook, engineering standards, and six runnable starter templates (node-ts / react-vite / python / go / spring-boot / monorepo). 项目初始化脚手架预设：严格流程 + 工程规范 + 六套模板。",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyanta123/dsh-preset-scaffold.git"
  },
  "bugs": {
    "url": "https://github.com/duyanta123/dsh-preset-scaffold/issues"
  },
  "homepage": "https://github.com/duyanta123/dsh-preset-scaffold#readme",
  "scripts": {
    "test": "node --test test/manifest-template.test.mjs",
    "test:compat": "node test/dsh-compat.test.mjs"
  },
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "plugin/index.js",
    "cordis.patch.yml",
    "skills/",
    "templates/",
    "preset.yml",
    "agent.cordis.yml",
    "install.ps1",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scaffolding",
    "skills",
    "templates",
    "project-init",
    "agent"
  ]
}
