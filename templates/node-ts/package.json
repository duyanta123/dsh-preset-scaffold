{
  "name": "my-node-ts-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.20.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0"
  }
}